[Unit]
Description=Axon session activity journal
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=axon
WorkingDirectory=/opt/axon/software/activity-journal
StateDirectory=axon-activity
ExecStart=/usr/bin/python3 journal.py --db /var/lib/axon-activity/activity.sqlite3 --broker localhost
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/axon-activity

[Install]
WantedBy=multi-user.target
