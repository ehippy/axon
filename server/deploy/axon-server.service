[Unit]
Description=Axon session activity journal
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=axon
WorkingDirectory=/var/lib/axon-activity
StateDirectory=axon-activity
StateDirectoryMode=0700
EnvironmentFile=-/etc/axon/server.env
ExecStart=/opt/axon/server/bin/axon-server --db /var/lib/axon-activity/activity.sqlite3
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/axon-activity

[Install]
WantedBy=multi-user.target
